# ---- LLM provider ----
OPENAI_API_KEY=

# ---- Config overrides (all optional; omit to use defaults) ----
# TRADEAGENTS_LLM_PROVIDER=openai
# TRADEAGENTS_DEEP_THINK_LLM=gpt-4o
# TRADEAGENTS_QUICK_THINK_LLM=gpt-4o-mini
# TRADEAGENTS_BACKEND_URL=
# TRADEAGENTS_OUTPUT_LANGUAGE=English
# TRADEAGENTS_MAX_DEBATE_ROUNDS=1
# TRADEAGENTS_MAX_RISK_ROUNDS=1
# TRADEAGENTS_CHECKPOINT_ENABLED=false
# TRADEAGENTS_TEMPERATURE=

# ---- Storage locations (override ~/.tradeagents) ----
# TRADEAGENTS_RESULTS_DIR=
# TRADEAGENTS_CACHE_DIR=

# ---- Langfuse tracing (optional) ----
# Set both keys and tracing is on; leave them unset and the pipeline runs
# without it. Get credentials from your Langfuse project settings.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com     # EU; use us.cloud.langfuse.com for US

# ---- Progress display / streaming ----
# TRADEAGENTS_STREAMING=true    # turn token streaming on for headless runs
# TRADEAGENTS_LANGFUSE=auto     # auto | on | off


# ---- Alpha Vantage (alternative prices/indicators/fundamentals/news) ----
# ALPHA_VANTAGE_API_KEY=...

# ---- FRED macro series ----
# FRED_API_KEY=...

# ---- SEC EDGAR (as-filed US fundamentals) ----
# SEC requires a User-Agent identifying you and a contact address.
# SEC_EDGAR_USER_AGENT="Your Name your@email.com"